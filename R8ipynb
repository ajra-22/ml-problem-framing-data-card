    "ConfusionMatrixDisplay(confusion_matrix(y_test, pred), display_labels=[\"ham\", \"spam\"]).plot(ax=ax[0], cmap=\"Blues\", colorbar=False)\n",
    "ax[0].set_title(\"Deep MLP — test confusion matrix\")\n",
    "for name, p in [(\"Deep MLP\", p_test), (\"Logistic Regression\", p_lr)]:\n",
