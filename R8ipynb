    "## 8. Inference on unseen sample inputs with confidence scores\n",
    "`predict_messages()` takes raw strings and returns the label and the model's confidence in that label. Confidence = P(spam) if predicted spam, else 1 − P(spam)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1513edfa",
   "metadata": {},
   "outputs": [],
   "source": [
    "@torch.no_grad()\n",
    "def predict_messages(texts, model=model, vectorizer=vectorizer, threshold=0.5):\n",
    "    model.eval()\n",
    "    X = torch.tensor(vectorizer.transform(texts).toarray(), dtype=torch.float32).to(DEVICE)\n",
    "    p_spam = torch.sigmoid(model(X)).cpu().numpy()\n",
    "    label = np.where(p_spam >= threshold, \"SPAM\", \"HAM\")\n",
    "    conf  = np.where(p_spam >= threshold, p_spam, 1 - p_spam)\n",
    "    return pd.DataFrame({\"message\": texts, \"prediction\": label, \"confidence\": (conf * 100).round(1).astype(str) + \"%\",\n",
    "                         \"P(spam)\": p_spam.round(4)})\n",
    "\n",
    "samples = [\n",
    "    \"Congratulations! You've won a FREE iPhone 15. Click http://bit.ly/claim-now to claim your prize today!\",\n",
    "    \"Hey, are we still meeting for lunch tomorrow at 1?\",\n",
    "    \"URGENT! Your account has been selected for a £1000 cash prize. Call 09061701461 now to claim. T&Cs apply\",\n",
    "    \"Can you send me the notes from today's DSA lecture? I missed the last 20 minutes.\",\n",
    "    \"WINNER!! As a valued network customer you have been selected to receive a free ringtone. Reply WIN to 80082\",\n",
    "    \"Mom said dinner is ready, come home soon\",\n",
    "    \"Get a FREE loan approval in 5 minutes. Text LOAN to 56789, limited offer, no documents needed!\",\n",
    "    \"I'll call you after the lab session, my phone is on silent right now\",\n",
    "    \"Your OTP for login is 483920. Do not share it with anyone.\",\n",
    "    \"Free entry in our weekly contest! Text STOP to opt out, msgs cost 50p each\",\n",
    "]\n",
    "with pd.option_context(\"display.max_colwidth\", 95, \"display.width\", 200):\n",
    "    display(predict_messages(samples))"
   ]
  },
